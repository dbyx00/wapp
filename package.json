{
  "name": "wapp",
  "version": "0.1.0",
  "description": "Windows Web App Installer - Convert URLs into installable Windows apps",
  "main": "dist/index.js",
  "bin": {
    "wapp": "./dist/cli/wappCommand.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli/wappCommand.js",
    "dev": "ts-node src/cli/wappCommand.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "windows",
    "cli",
    "webapp",
    "installer",
    "shortcut"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
